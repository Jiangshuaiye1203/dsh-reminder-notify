{
  "name": "dsh-reminder-notify",
  "version": "0.25.1",
  "description": "DSH 桌面提醒插件：把「完成/需要决定」提醒变成 notify_user 工具（浮动卡片 + 提示音，不抢焦点，纯 PowerShell 源码宿主，仓库零 exe）",
  "author": "Jiangshuaiye1203",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "client.js",
    "host",
    "assets",
    "locale",
    "docs",
    "scripts",
    "icon.svg",
    "README.md",
    "LICENSE",
    "publish"
  ],
  "icon": "./icon.svg",
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notify",
    "reminder",
    "toast"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jiangshuaiye1203/dsh-reminder-notify.git"
  },
  "homepage": "https://jiangshuaiye1203.github.io/dsh-reminder-notify/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
